{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "bleu-900", "color": "#0F2F37", "name": "Bleu nuit" },
				{ "slug": "bleu-800", "color": "#163F48", "name": "Bleu profond" },
				{ "slug": "bleu-700", "color": "#246170", "name": "Bleu Villefontaine" },
				{ "slug": "bleu-500", "color": "#679EAA", "name": "Bleu clair (décor uniquement)" },
				{ "slug": "bleu-100", "color": "#E8F2F4", "name": "Bleu très pâle" },
				{ "slug": "vert-700", "color": "#476410", "name": "Vert foncé" },
				{ "slug": "vert-600", "color": "#5A7D1F", "name": "Vert Villefontaine accessible" },
				{ "slug": "vert-400", "color": "#A7C13C", "name": "Vert Villefontaine (décor uniquement)" },
				{ "slug": "vert-100", "color": "#F2F7E4", "name": "Vert très pâle" },
				{ "slug": "encre", "color": "#1B2B30", "name": "Texte" },
				{ "slug": "encre-douce", "color": "#4A5A5F", "name": "Texte secondaire" },
				{ "slug": "blanc", "color": "#FFFFFF", "name": "Blanc" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1176px"
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"padding": false,
			"margin": false,
			"blockGap": false
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Figtree",
					"slug": "figtree",
					"fontFamily": "Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"name": "Unbounded",
					"slug": "unbounded",
					"fontFamily": "Unbounded, Figtree, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Unbounded",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/unbounded-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "petit", "size": "13px", "name": "Petit", "fluid": false },
				{ "slug": "normal", "size": "15px", "name": "Normal", "fluid": false },
				{ "slug": "moyen", "size": "17.5px", "name": "Moyen", "fluid": false },
				{ "slug": "grand", "size": "23px", "name": "Grand", "fluid": { "min": "19.5px", "max": "23px" } },
				{ "slug": "tres-grand", "size": "33.5px", "name": "Très grand", "fluid": { "min": "24.5px", "max": "33.5px" } }
			]
		},
		"blocks": {
			"core/button": {
				"color": { "palette": [
					{ "slug": "bleu-700", "color": "#246170", "name": "Bleu Villefontaine" },
					{ "slug": "vert-600", "color": "#5A7D1F", "name": "Vert Villefontaine accessible" },
					{ "slug": "blanc", "color": "#FFFFFF", "name": "Blanc" }
				] }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--blanc)",
			"text": "var(--wp--preset--color--encre)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--figtree)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--bleu-700)" },
				":hover": { "color": { "text": "var(--wp--preset--color--bleu-800)" } }
			},
			"heading": {
				"typography": { "fontWeight": "800", "lineHeight": "1.2" }
			},
			"h1": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--unbounded)", "fontWeight": "700", "fontSize": "clamp(25.5px, 3.52vw, 43px)", "letterSpacing": "-0.02em" }
			},
			"h2": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--unbounded)", "fontWeight": "700", "fontSize": "clamp(21px, 2.29vw, 28px)", "letterSpacing": "-0.02em" }
			},
			"h3": { "typography": { "fontSize": "19.5px" } },
			"h4": { "typography": { "fontSize": "16.5px" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--bleu-700)", "text": "var(--wp--preset--color--blanc)" },
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "700", "fontSize": "14px" },
				"spacing": { "padding": { "top": "13px", "bottom": "13px", "left": "24px", "right": "24px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--bleu-800)" } }
			}
		},
		"blocks": {
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--vert-400)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--moyen)" }
			},
			"core/separator": {
				"color": { "text": "#D5E3E6" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-pleine-largeur", "title": "Page pleine largeur (sans colonne latérale)", "postTypes": [ "page" ] }
	]
}
