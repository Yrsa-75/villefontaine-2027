{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vf/sous-pages",
	"version": "1.5.18",
	"title": "Pages de la rubrique",
	"category": "villefontaine",
	"icon": "screenoptions",
	"description": "Pavés automatiques vers les sous-pages de la page en cours : une image ou une icône, un titre.",
	"textdomain": "socle-villefontaine",
	"attributes": {
		"titre": {
			"type": "string",
			"default": "Dans cette rubrique"
		},
		"titreMasque": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"multiple": false
	},
	"editorScript": "vf-socle-sous-pages-editeur",
	"style": "file:./style.css",
	"render": "file:./rendu.php"
}
