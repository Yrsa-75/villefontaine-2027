{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vf/agenda-prochains",
	"version": "1.1.4",
	"title": "Prochains événements",
	"category": "villefontaine",
	"icon": "calendar-alt",
	"description": "Les prochains rendez-vous de l’agenda, avec des filtres par thématique. Peut se limiter à quelques thématiques (ex. sport et culture). Mise à jour automatique chaque jour.",
	"textdomain": "agenda-villefontaine",
	"attributes": {
		"nombre": {
			"type": "number",
			"default": 6
		},
		"thematique": {
			"type": "string",
			"default": ""
		},
		"thematiques": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		},
		"format": {
			"type": "string",
			"enum": [
				"cartes",
				"liste"
			],
			"default": "cartes"
		},
		"titre": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "vf-agenda-agenda-prochains-editeur",
	"style": "file:./style.css",
	"viewScript": "vf-agenda-filtres",
	"render": "file:./rendu.php"
}
